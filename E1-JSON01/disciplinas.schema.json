{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Disciplinas",
  "type": "object",
  "properties": {
    "disciplinas": {
      "type": "object",
      "properties": {
        "curso": {
          "type": "string"
        },
        "disciplina": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "codigo": { "type": "string" },
              "nome": { "type": "string" },
              "ano": { "type": "integer" },
              "teorica": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "horas": { "type": "integer" }
                },
                "required": ["nome", "horas"] 
              },
              "pratica": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "horas": { "type": "integer" }
                },
                "required": ["nome", "horas"]
              }
            },
            "required": ["codigo", "nome", "teorica"]
          }
        }
      },
      "required": ["curso", "disciplina"]
    }
  },
  "required": ["disciplinas"]
}